    <!-- TAMPILAN PRODUK PER BARIS INDEPENDEN -->
    <% if (productList.length > 0) { %>
        <div class="product-rows-container">
            <% rows.forEach((rowProducts, rIdx) => { %>
                <% if (rowProducts.length > 0) { %>
                    <div class="product-row-wrapper reveal-on-scroll" id="rowWrapper_<%= rIdx %>">
                        
                        <button class="slider-btn prev d-none d-md-flex" onclick="slideRow('<%= rIdx %>', -1)" title="Geser baris ke kiri">
                            <i class="bi bi-chevron-left"></i>
                        </button>

                        <div class="product-single-row" id="productRow_<%= rIdx %>">
                            <% rowProducts.forEach(product => { %>
                                <% 
                                    const subCat = product.sub_category || 'beverages';
                                    const currentPrice = Number(product.price);
                                    const currentPriceFormatted = currentPrice.toLocaleString('id-ID');
                                    
                                    const hasPromo = product.original_price && Number(product.original_price) > currentPrice;
                                    const originalPriceFormatted = hasPromo ? Number(product.original_price).toLocaleString('id-ID') : null;
                                    const myYogyaPriceFormatted = product.myyogya_price ? Number(product.myyogya_price).toLocaleString('id-ID') : null;

                                    let textWA = `Halo Yomart Rambay, saya ingin menanyakan ketersediaan stok produk:\n\n*${product.name}*\nKategori: ${activeTitle}`;
                                    if (hasPromo) {
                                        textWA += `\nHarga Normal: Rp ${originalPriceFormatted}\nHarga Promo: Rp ${currentPriceFormatted}`;
                                    } else {
                                        textWA += `\nHarga: Rp ${currentPriceFormatted}`;
                                    }
                                    if (myYogyaPriceFormatted) {
                                        textWA += `\nHarga Dengan MyYOGYA: Rp ${myYogyaPriceFormatted}`;
                                    }
                                    if (product.promo_end) {
                                        textWA += `\nPeriode Promo: s.d. ${product.promo_end}`;
                                    }
                                    textWA += `\n\nApakah stoknya masih tersedia? Terima kasih.`;

                                    const waLink = `https://wa.me/${adminWhatsAppNumber}?text=${encodeURIComponent(textWA)}`;
                                %>

                                <div class="product-item" data-subcat="<%= subCat === 'perawatan-wanita' ? 'kosmetik-wanita' : subCat %>">
                                    <div class="product-card shadow-sm">
                                        
                                        <!-- FOTO PRODUK -->
                                        <div class="product-img-wrapper" onclick="zoomProduct('/image/<%= product.image %>', '<%= product.name.replace(/'/g, "\\'") %>', '<%= waLink %>')" title="Klik untuk lihat detail gambar">
                                            <img src="/image/<%= product.image %>" class="product-image" alt="<%= product.name %>" onerror="this.onerror=null; this.src='https://placehold.co/300x300?text=Produk';">
                                            <div class="zoom-hint-badge">
                                                <i class="bi bi-arrows-fullscreen"></i> Lihat detail gambar
                                            </div>
                                        </div>

                                        <div class="product-card-body">
                                            <div class="product-name" title="<%= product.name %>"><%= product.name %></div>

                                            <div class="product-pricing-box">
                                                <% if (hasPromo) { %>
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <span class="price-normal">Rp <%= originalPriceFormatted %></span>
                                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25" style="font-size: 0.55rem; padding: 1px 3px;">PROMO</span>
                                                    </div>
                                                    <div class="product-price text-danger">
                                                        Rp <%= currentPriceFormatted %>
                                                    </div>
                                                <% } else { %>
                                                    <div class="product-price text-success">
                                                        Rp <%= currentPriceFormatted %>
                                                    </div>
                                                <% } %>

                                                <% if (myYogyaPriceFormatted) { %>
                                                    <div class="myyogya-badge-box">
                                                        <span class="myyogya-label"><i class="bi bi-stars"></i> MyYOGYA</span>
                                                        <span class="myyogya-price">Rp <%= myYogyaPriceFormatted %></span>
                                                    </div>
                                                <% } %>

                                                <% if (product.promo_end) { %>
                                                    <div class="promo-period-text">
                                                        <i class="bi bi-clock-history me-1"></i> s.d. <%= product.promo_end %>
                                                    </div>
                                                <% } %>
                                            </div>

                                            <div class="product-action-box">
                                                <a href="<%= waLink %>" target="_blank" class="btn btn-wa w-100 d-flex align-items-center justify-content-center gap-1">
                                                    <i class="bi bi-whatsapp"></i> Cek Ketersediaan
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>

                        <button class="slider-btn next d-none d-md-flex" onclick="slideRow('<%= rIdx %>', 1)" title="Geser baris ke kanan">
                            <i class="bi bi-chevron-right"></i>
                        </button>

                    </div>
                <% } %>
            <% }) %>
        </div>

        <div id="subEmptyMessage" class="text-center py-4 d-none rounded-3 shadow-sm mt-3 border">
            <div class="fs-2">📦</div>
            <div class="text-muted small mt-1">Tidak ada produk dalam kategori barang ini</div>
        </div>

    <% } else { %>
        <div class="text-center py-4 rounded-3 shadow-sm mt-3 border bg-body-tertiary reveal-on-scroll">
            <div class="fs-2">📦</div>
            <div class="text-muted small mt-1">Belum ada produk untuk kategori promo <%= activeTitle %></div>
        </div>
    <% } %>

    <!-- SEKSI SCREENSHOT ULASAN -->
    <div class="mt-5 mb-3 reveal-on-scroll">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="fw-bold mb-0 fs-6 fs-md-5">
                <i class="bi bi-chat-square-quote-fill text-success me-1"></i> Ulasan Kami
            </h5>
        </div>

        <% if (reviewList.length > 0) { %>
            <div class="review-slider">
                <% reviewList.forEach((rev, idx) => { %>
                    <div class="review-card shadow-sm" onclick="zoomReview('/image/<%= rev.image %>')" title="Klik untuk memperbesar">
                        <img src="/image/<%= rev.image %>" class="review-img" alt="Ulasan" onerror="this.onerror=null; this.src='https://placehold.co/400x260/20c997/ffffff?text=Ulasan+Pelanggan';">
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="p-3 text-center rounded border bg-body-tertiary">
                <div class="fs-3 mb-1">💬</div>
                <div class="small text-muted">Belum ada screenshot ulasan yang diunggah oleh admin.</div>
            </div>
        <% } %>
    </div>

</div>

