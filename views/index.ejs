            <div class="modal-body p-2 text-center">
                <img id="reviewZoomImg" src="" class="img-fluid rounded shadow-sm" alt="Detail Ulasan" style="max-height: 75vh; object-fit: contain;">
            </div>
        </div>
    </div>
</div>

<!-- FOOTER -->
<footer class="footer-yomart py-4 mt-auto reveal-on-scroll">
    <div class="container">
        <div class="row gy-3 text-start align-items-start">
            <div class="col-12 col-md-7">
                <h6 class="text-white fw-bold mb-2 fs-6">
                    <i class="bi bi-pin-map-fill me-1 text-warning"></i> Lokasi Toko
                </h6>
                <p class="small mb-0 opacity-90" style="line-height: 1.6;">
                    Jl. Pajajaran 1 Jl. Raya Rambay, Sukamantri, Kec. Cisaat, Kabupaten Sukabumi, Jawa Barat 43152
                </p>
            </div>
            <div class="col-12 col-md-5">
                <h6 class="text-white fw-bold mb-2 fs-6">
                    <i class="bi bi-clock-fill me-1 text-warning"></i> Jam Operasional
                </h6>
                <div class="small opacity-90">
                    <div class="mb-1">Senin – Jumat: <strong class="text-white">07.00 – 22.00 WIB</strong></div>
                    <div>Sabtu – Minggu: <strong class="text-white">06.00 – 22.00 WIB</strong></div>
                </div>
            </div>
        </div>
        <div class="border-top border-white border-opacity-25 mt-4 pt-3 text-center small" style="color: #c8e6c9;">
            &copy; <%= new Date().getFullYear() %> <strong class="text-white">Yomart Rambay</strong>.
        </div>
    </div>
</footer>

<!-- Bootstrap JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    const revealElements = document.querySelectorAll('.reveal-on-scroll');
    if ('IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-revealed');
                    observer.unobserve(entry.target);
                }
            });
        }, {
            threshold: 0.08,
            rootMargin: '0px 0px -30px 0px'
        });

        revealElements.forEach(el => revealObserver.observe(el));
    } else {
        revealElements.forEach(el => el.classList.add('is-revealed'));
    }

    const htmlElement = document.documentElement;
    const themeToggleBtn = document.getElementById('themeToggleBtn');
    const themeIcon = document.getElementById('themeIcon');

    const savedTheme = localStorage.getItem('yomart_theme') || 'light';
    applyTheme(savedTheme);

    function applyTheme(theme) {
        htmlElement.setAttribute('data-bs-theme', theme);
        localStorage.setItem('yomart_theme', theme);

        if (theme === 'dark') {
            themeIcon.className = 'bi bi-sun-fill';
            themeToggleBtn.setAttribute('title', 'Ganti ke Mode Terang');
        } else {
            themeIcon.className = 'bi bi-moon-stars-fill';
            themeToggleBtn.setAttribute('title', 'Ganti ke Mode Gelap');
        }
    }

    if (themeToggleBtn) {
        themeToggleBtn.addEventListener('click', () => {
            const currentTheme = htmlElement.getAttribute('data-bs-theme') || 'light';
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            applyTheme(newTheme);
        });
    }

    const astroCatBox = document.getElementById('astroCatBox');
    const astroSpeech = document.getElementById('astroSpeech');
    let isAstroBoosting = false;
    let astroSpeechTimer = null;

    const astroQuotes = [
        "Halo Sobat Yomart",
        "Promo menarik!",
        "Harga Hemat"
    ];

    if (astroCatBox) {
        astroCatBox.addEventListener('click', function(e) {
            e.stopPropagation();
            if (isAstroBoosting) return;

            isAstroBoosting = true;
            astroCatBox.classList.add('astro-boost');

            const randomQuote = astroQuotes[Math.floor(Math.random() * astroQuotes.length)];
            astroSpeech.innerText = randomQuote;
            astroSpeech.classList.add('show');

            clearTimeout(astroSpeechTimer);
            astroSpeechTimer = setTimeout(() => {
                astroSpeech.classList.remove('show');
            }, 2000);

            setTimeout(() => {
                astroCatBox.classList.remove('astro-boost');
                isAstroBoosting = false;
            }, 2000);
        });
    }

    const filterContainer = document.getElementById('subFilterContainer');
    let isFilterInteracting = false;
    let singleSetWidth = 0;
    let scrollPos = 0;
    let resumeTimeout = null;

    if (filterContainer) {
        const originalContent = filterContainer.innerHTML;
        filterContainer.innerHTML += originalContent;

        function calculateWidth() {
            singleSetWidth = filterContainer.scrollWidth / 2;
        }

        window.addEventListener('load', calculateWidth);
        calculateWidth();

        function animateScroll() {
            if (!isFilterInteracting && singleSetWidth > 0) {
                scrollPos += 0.6;
                if (scrollPos >= singleSetWidth) {
                    scrollPos = 0;
                }
                filterContainer.scrollLeft = scrollPos;
            }
            requestAnimationFrame(animateScroll);
        }
        requestAnimationFrame(animateScroll);

        filterContainer.addEventListener('mouseenter', () => { isFilterInteracting = true; });
        filterContainer.addEventListener('mouseleave', () => {
            scrollPos = filterContainer.scrollLeft;
            isFilterInteracting = false;
        });

        filterContainer.addEventListener('touchstart', () => {
            isFilterInteracting = true;
            clearTimeout(resumeTimeout);
        }, { passive: true });

        filterContainer.addEventListener('touchend', () => {
            scrollPos = filterContainer.scrollLeft;
            resumeTimeout = setTimeout(() => { isFilterInteracting = false; }, 2000);
        });

        filterContainer.addEventListener('scroll', () => {
            if (isFilterInteracting && singleSetWidth > 0) {
                scrollPos = filterContainer.scrollLeft;
                if (scrollPos >= singleSetWidth) {
                    scrollPos -= singleSetWidth;
                    filterContainer.scrollLeft = scrollPos;
                } else if (scrollPos <= 0) {
                    scrollPos += singleSetWidth;
                    filterContainer.scrollLeft = scrollPos;
                }
            }
        }, { passive: true });
    }

    function slideFilterCategories(direction) {
        if (!filterContainer) return;
        isFilterInteracting = true;
        clearTimeout(resumeTimeout);
        filterContainer.scrollBy({
            left: direction * 220,
            behavior: 'smooth'
        });
        resumeTimeout = setTimeout(() => {
            scrollPos = filterContainer.scrollLeft;
            isFilterInteracting = false;
        }, 2500);
    }

    function slideRow(rowIndex, direction) {
        const row = document.getElementById(`productRow_${rowIndex}`);
        if (row) {
            const scrollAmount = row.clientWidth * 0.75;
            row.scrollBy({
                left: direction * scrollAmount,
                behavior: 'smooth'
            });
        }
    }

    document.querySelectorAll('.product-single-row').forEach(row => {
        row.addEventListener('wheel', (evt) => {
            if (evt.deltaY !== 0) {
                evt.preventDefault();
                row.scrollLeft += evt.deltaY * 1.5;
            }
        }, { passive: false });
    });

    function filterSubCategory(subCat, btn) {
        document.querySelectorAll('.filter-pill').forEach(pill => {
            if (pill.getAttribute('data-filter') === subCat) {
                pill.classList.add('active');
            } else {
                pill.classList.remove('active');
            }
        });

        let totalVisible = 0;
        const rowWrappers = document.querySelectorAll('.product-row-wrapper');

        rowWrappers.forEach(wrapper => {
            const items = wrapper.querySelectorAll('.product-item');
            let rowVisibleCount = 0;

            items.forEach(item => {
                const itemCat = item.getAttribute('data-subcat');
                if (
                    subCat === 'all' || 
                    itemCat === subCat || 
                    (subCat === 'kosmetik-wanita' && itemCat === 'perawatan-wanita') ||
                    (subCat === 'household' && itemCat === 'pencuci-piring')
                ) {
                    item.style.display = 'block';
                    rowVisibleCount++;
                    totalVisible++;
                } else {
                    item.style.display = 'none';
                }
            });

            if (rowVisibleCount === 0) {
                wrapper.classList.add('d-none');
            } else {
                wrapper.classList.remove('d-none');
            }
        });

        const countBadge = document.getElementById('visibleProductCount');
        if (countBadge) countBadge.innerText = `${totalVisible} Produk`;

        const emptyMsg = document.getElementById('subEmptyMessage');
        if (emptyMsg) {
            if (totalVisible === 0) {
                emptyMsg.classList.remove('d-none');
            } else {
                emptyMsg.classList.add('d-none');
            }
        }
    }

    function zoomProduct(imgSrc, title, waLink) {
        const img = document.getElementById('productZoomImg');
        const modalTitle = document.getElementById('productModalTitle');
        const waBtn = document.getElementById('productModalWaBtn');
        if (img) img.src = imgSrc;
        if (modalTitle) modalTitle.innerText = title;
        if (waBtn) waBtn.href = waLink;
        const modal = new bootstrap.Modal(document.getElementById('modalZoomProduct'));
        modal.show();
    }

    function zoomReview(imgSrc) {
        const zoomImg = document.getElementById('reviewZoomImg');
        if (zoomImg) {
            zoomImg.src = imgSrc;
            const modalEl = document.getElementById('modalZoomReview');
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        }
    }
</script>

</body>
</html>