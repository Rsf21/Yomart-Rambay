<!-- Bootstrap JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // ========================================================
    // SCROLL REVEAL (FADE IN SMOOTH ON SCROLL)
    // ========================================================
    const revealElements = document.querySelectorAll('.reveal-on-scroll');
    if ('IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-revealed');
                    observer.unobserve(entry.target);
                }
            });
        }, {
            threshold: 0.08,
            rootMargin: '0px 0px -30px 0px'
        });

        revealElements.forEach(el => revealObserver.observe(el));
    } else {
        revealElements.forEach(el => el.classList.add('is-revealed'));
    }

    // ========================================================
    // FUNGSI ZOOM FOTO PROFIL
    // ========================================================
    function zoomProfile(imgSrc) {
        const modalImg = document.getElementById('modalProfileImg');
        if (modalImg && imgSrc) {
            modalImg.src = imgSrc;
        }
        const modalEl = document.getElementById('modalZoomProfile');
        if (modalEl) {
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        }
    }

    // ========================================================
    // INISIALISASI TOOLTIP (OTOMATIS HILANG SAAT DIKLIK)
    // ========================================================
    const tooltipTriggerList = document.querySelectorAll('.auto-hide-tooltip');
    const allTooltips = [];

    tooltipTriggerList.forEach(el => {
        const tooltip = new bootstrap.Tooltip(el, {
            trigger: 'hover' // Di PC muncul saat hover
        });
        allTooltips.push(tooltip);

        let timer = null;
        // Saat diklik / disentuh di HP: muncul lalu otomatis hilang
        el.addEventListener('click', function () {
            allTooltips.forEach(t => { if (t !== tooltip) t.hide(); });

            tooltip.show();
            clearTimeout(timer);
            timer = setTimeout(() => {
                tooltip.hide();
                el.blur();
            }, 1200); // Hilang otomatis dalam 1.2 detik
        });
    });

    // Tooltip untuk Social Button biasa
    document.querySelectorAll('.social-btn').forEach(btn => {
        new bootstrap.Tooltip(btn, { trigger: 'hover' });
    });

    // ========================================================
    // DARK / LIGHT THEME TOGGLE
    // ========================================================
    const htmlElement = document.documentElement;
    const themeToggleBtn = document.getElementById('themeToggleBtn');
    const themeIcon = document.getElementById('themeIcon');

    const savedTheme = localStorage.getItem('yomart_theme') || 'light';
    applyTheme(savedTheme);

    function applyTheme(theme) {
        htmlElement.setAttribute('data-bs-theme', theme);
        localStorage.setItem('yomart_theme', theme);

        if (theme === 'dark') {
            themeIcon.className = 'bi bi-sun-fill';
            themeToggleBtn.setAttribute('title', 'Ganti ke Mode Terang');
        } else {
            themeIcon.className = 'bi bi-moon-stars-fill';
            themeToggleBtn.setAttribute('title', 'Ganti ke Mode Gelap');
        }
    }

    if (themeToggleBtn) {
        themeToggleBtn.addEventListener('click', () => {
            const currentTheme = htmlElement.getAttribute('data-bs-theme') || 'light';
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            applyTheme(newTheme);
        });
    }
</script>

</body>
</html>