<!DOCTYPE html>
<html lang="id" data-bs-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Google Fonts: Outfit & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3.3 & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/index.css">

    <style>
        /* EFEK MUNCUL PUDAR SMOOTH SAAT DI-SCROLL */
        .reveal-on-scroll {
            opacity: 0;
            transform: translateY(28px);
            transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
            will-change: opacity, transform;
        }

        .reveal-on-scroll.is-revealed {
            opacity: 1;
            transform: translateY(0);
        }

        .btn-burger-custom {
            border: none;
            background: transparent;
            padding: 4px 6px;
            color: #111111;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .btn-burger-icon {
            font-size: 1.75rem;
            line-height: 1;
            color: #111111;
        }

        .btn-theme-toggle {
            border: 1px solid #dee2e6;
            background-color: transparent;
            color: #495057;
            width: 38px;
            height: 38px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: all 0.25s ease;
        }
        .btn-theme-toggle:hover {
            background-color: rgba(0,0,0,0.05);
            color: #1b7a42;
        }

        .about-card {
            border-radius: 20px;
            border: 1px solid #eaeaea;
            background-color: #ffffff;
            overflow: hidden;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
        }

        .profile-img-container {
            position: relative;
            display: inline-block;
            margin-bottom: 10px;
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
        }

        .profile-img {
            width: 185px;
            height: 220px;
            object-fit: cover;
            border-radius: 26px;
            border: 4px solid #cfc3c3;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
            background-color: #eff7ff;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .profile-img-container:hover .profile-img {
            transform: scale(1.03);
            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.18);
        }

        .profile-zoom-hint {
            position: absolute;
            bottom: 8px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.65);
            color: #ffffff;
            font-size: 0.65rem;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 12px;
            backdrop-filter: blur(4px);
            opacity: 0;
            transition: opacity 0.25s ease;
            white-space: nowrap;
            pointer-events: none;
        }
        .profile-img-container:hover .profile-zoom-hint {
            opacity: 1;
        }

        .intro-heading {
            display: inline-block;
            animation: introFadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            opacity: 0;
            transform: translateY(16px);
        }

        .name-gradient-elegant {
            font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
            font-size: 1.85rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            display: inline-block;
            vertical-align: middle;
            background: linear-gradient(135deg, #1f2937 0%, #4b5563 45%, #9ca3af 80%, #374151 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        @media (min-width: 768px) {
            .name-gradient-elegant {
                font-size: 2.35rem;
            }
            .profile-img {
                width: 200px;
                height: 235px;
            }
        }

        @keyframes introFadeUp {
            0% { opacity: 0; transform: translateY(16px); }
            100% { opacity: 1; transform: translateY(0); }
        }

        .wave-hand {
            display: inline-block;
            animation: waveAnim 2.2s infinite;
            transform-origin: 70% 70%;
        }

        @keyframes waveAnim {
            0% { transform: rotate(0.0deg); }
            10% { transform: rotate(14.0deg); }
            20% { transform: rotate(-8.0deg); }
            30% { transform: rotate(14.0deg); }
            40% { transform: rotate(-4.0deg); }
            50% { transform: rotate(10.0deg); }
            60% { transform: rotate(0.0deg); }
            100% { transform: rotate(0.0deg); }
        }

        .social-btn {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            text-decoration: none;
            transition: all 0.25s ease;
            box-shadow: 0 2px 6px rgba(0,0,0,0.06);
        }
        .social-btn:hover {
            transform: translateY(-3px) scale(1.08);
            box-shadow: 0 6px 14px rgba(0,0,0,0.15);
            color: #ffffff;
        }
        .social-wa { background-color: #25D366; color: #ffffff; border: 1px solid #20ba5a; }
        .social-ig { background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%); color: #ffffff; border: none; }
        .social-gh { background-color: #24292e; color: #ffffff; border: 1px solid #1b1f23; }

        /* ======================================================== */
        /* PURE LOGO STYLING */
        /* ======================================================== */
        .tech-logo-item {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 8px;
            background: transparent;
            border: none;
            border-radius: 12px;
            transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            cursor: pointer;
            outline: none;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }
        .tech-logo-item:hover, 
        .tech-logo-item:focus,
        .tech-logo-item:active {
            transform: translateY(-5px) scale(1.15);
        }

        .tech-logo-img {
            width: 44px;
            height: 44px;
            object-fit: contain;
            display: block;
            filter: drop-shadow(0 2px 5px rgba(0,0,0,0.08));
            transition: filter 0.25s ease;
        }

        @media (min-width: 768px) {
            .tech-logo-img { width: 50px; height: 50px; }
            .tech-logo-item { padding: 10px; }
        }

        /* KOTAK PENJELASAN DI BAGIAN BAWAH */
        .about-tech-summary-box {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 16px 18px;
            text-align: left;
            transition: all 0.25s ease;
        }

        @media (min-width: 768px) {
            .about-tech-summary-box { padding: 20px 24px; }
        }

        /* DARK MODE */
        [data-bs-theme="dark"] body { background-color: #121417 !important; color: #ffffff !important; }
        [data-bs-theme="dark"] .navbar { background-color: #1a1f26 !important; border-bottom: 1px solid #2d3748; }
        [data-bs-theme="dark"] .btn-burger-custom, [data-bs-theme="dark"] .btn-burger-icon { color: #ffffff !important; }
        [data-bs-theme="dark"] .btn-theme-toggle { border-color: #374151; color: #fbbf24; }
        [data-bs-theme="dark"] .about-card { background-color: #1a1f26; border-color: #2d3748; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4); }
        [data-bs-theme="dark"] .profile-img { border-color: #69756e; box-shadow: 0 8px 20px rgba(72, 187, 120, 0.25); }
        [data-bs-theme="dark"] .name-gradient-elegant { background: linear-gradient(135deg, #ffffff 0%, #f1f5f9 35%, #94a3b8 75%, #e2e8f0 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        
        [data-bs-theme="dark"] .tech-logo-img { filter: drop-shadow(0 3px 8px rgba(0,0,0,0.6)); }
        
        [data-bs-theme="dark"] .about-tech-summary-box { background-color: #1e293b !important; border-color: #334155 !important; }
        [data-bs-theme="dark"] .about-tech-summary-box p { color: #cbd5e1 !important; }
        [data-bs-theme="dark"] .about-tech-summary-box strong { color: #f8fafc !important; }

        [data-bs-theme="dark"] .social-gh { background-color: #333d47; border-color: #444d56; }
        [data-bs-theme="dark"] p, [data-bs-theme="dark"] .text-secondary, [data-bs-theme="dark"] .text-muted, [data-bs-theme="dark"] .about-desc { color: #ffffff !important; }
        [data-bs-theme="dark"] .modal-content { background-color: #1a1f26; color: #f8fafc; border: 1px solid #374151; }
        [data-bs-theme="dark"] .modal-body { background-color: #1a1f26 !important; }
    </style>
</head>

